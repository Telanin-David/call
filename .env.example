# Copy this to .env and fill in real values. Never commit .env.

# Server
ENV=development
ADDR=:8080

# Database
DATABASE_URL=postgres://dialer:dialer@localhost:5432/dialer?sslmode=disable

# Cache
CACHE_URL=valkey://localhost:6379

# Session (generate with: openssl rand -hex 32)
SESSION_KEY=

# Telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_APP_ID=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Smile ID (KYC)
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
SMILEID_CALLBACK_URL=

# Email (Resend or Postmark)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=noreply@dialer.app

# SMS (Termii for Nigeria, WhatsApp fallback)
TERMII_API_KEY=

# Object storage (Cloudflare R2 or Backblaze B2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# AI (transcripts + summaries)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Sentry
SENTRY_DSN=
