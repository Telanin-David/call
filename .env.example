# Copy this to .env and fill in real values. Never commit .env.

# Server
ENV=development
ADDR=:8080

# Database
DATABASE_URL=postgres://dialer:dialer@localhost:5432/dialer?sslmode=disable

# Cache
CACHE_URL=valkey://localhost:6379

# Session (generate with: openssl rand -hex 32). Also keys the stored
# hashes of sign-up and reset codes. Required in production.
SESSION_KEY=

# Web app address, for links in emails, and the origins allowed to call
# the api from a browser (comma-separated; defaults to WEB_URL).
WEB_URL=http://localhost:5173
WEB_ORIGINS=

# Telnyx (numbers and calls). Without TELNYX_API_KEY, development uses a fake
# that hands out 555-01xx numbers which never ring; elsewhere renting numbers
# is off. TELNYX_CONNECTION_ID is the voice connection new numbers and browser
# phones join. TELNYX_PUBLIC_KEY (base64, from the portal) checks call webhooks;
# calling stays off outside development until it is set.
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_PUBLIC_KEY=
TELNYX_APP_ID=

# Paystack (cards from Nigeria, Ghana, Kenya). The wallet is in US dollars:
# PAYSTACK_CURRENCY is what Paystack charges in, and PAYSTACK_MINOR_PER_USD
# how many of its smallest units make $1 (100 for USD; e.g. 160000 kobo for
# a rate of 1,600 naira). Without keys, development uses a fake provider.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=USD
PAYSTACK_MINOR_PER_USD=100

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Smile ID (KYC)
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
# Where Smile ID sends results: https://<api>/webhooks/smileid
SMILEID_CALLBACK_URL=
# true (default) uses Smile ID's sandbox; set false for live checks.
SMILEID_SANDBOX=true

# Email (Resend or Postmark)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=noreply@dialer.app

# SMS (Termii for Nigeria, WhatsApp fallback). Without RESEND_API_KEY or
# TERMII_API_KEY, development prints codes in the api log instead of sending.
TERMII_API_KEY=
TERMII_SENDER_ID=Dialer
TERMII_BASE_URL=https://v3.api.termii.com

# File storage for call recordings (Cloudflare R2, or any S3-compatible
# store). S3_ENDPOINT is like https://<account>.r2.cloudflarestorage.com.
# Without these, recording is off outside development; development keeps
# files in DEV_FILES_DIR (default: a folder in the system temp dir).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
DEV_FILES_DIR=

# AI (transcripts + summaries)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Sentry
SENTRY_DSN=
